# Copiar a .env (raíz). Nunca commitear .env.
# Lo leen services/api (pydantic-settings) y docker-compose.yml.

ENV=dev                                  # dev | prod
SECRET_KEY=cambiar-en-produccion         # obligatorio y distinto del valor por defecto cuando ENV=prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080        # 7 días

DATABASE_URL=sqlite:///./data/ova.db     # dev. En Docker: postgresql+psycopg://ova:ova@db:5432/ova
ALLOWED_ORIGINS=http://localhost:5173    # separados por coma
TRUST_PROXY=false                        # true solo detrás de un proxy que SOBRESCRIBE X-Forwarded-For (límite de intentos por IP)

# Solo el backend la usa. Vacía => /api/chat responde 503.
# (El comentario va en su propia línea: un valor vacío seguido de "# ..." se leería como texto.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
MENTOR_EFFORT=medium                     # low | medium | high | xhigh | max
MENTOR_MAX_TOKENS=16000
MENTOR_SERVER_FALLBACK=true              # beta de Anthropic; poner false si la organización no la tiene habilitada

# Certificado y validación contra el contenido (F5-05).
# Manifiesto de actividades: por defecto services/api/app/data/actividades_manifest.json; si existe,
# la API valida resultados y progreso contra él (se genera con `python -m app.scripts.build_manifest`).
# Descomentar solo para usar otra ruta (debe existir) o dejarla vacía para desactivar la validación.
# ACTIVITIES_MANIFEST_PATH=
CERT_MIN_PORCENTAJE=70                   # % mínimo del puntaje máximo de las actividades obligatorias (solo con manifiesto)
PUBLIC_BASE_URL=http://localhost:5173    # URL pública del sitio: el PDF imprime {PUBLIC_BASE_URL}/verify/{codigo}

# Solo docker-compose
POSTGRES_USER=ova
POSTGRES_PASSWORD=ova
POSTGRES_DB=ova

# Panel docente: precios para ESTIMAR el costo del mentor (USD por millón de tokens).
# Por defecto, las tarifas de claude-opus-5. Ajustar si cambia el modelo o la tarifa.
PRECIO_ENTRADA_USD_POR_MTOK=5
PRECIO_SALIDA_USD_POR_MTOK=25
